<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<template id="report_patient_card_document">
		<t t-call="web.html_container">
			<t t-call="web.internal_layout">
				<t t-set="o" t-value="o.with_context(lang=doc_lang or env.lang)"/>
				<div class="page">
					<br></br>
					<br></br>
					<br></br>
					<br></br>
					<div>
						<table>
							<tbody>
								<tr>
									<td>
									</td>
									<td style="vertical-align: top;">
										<div style="margin-left: 10px; margin-right: 10px; margin-top: 10px; margin-bottom: 10px; font-size:16px">
											<div><b>Patient ID:</b> <span t-field="o.name"/></div>
											<div><b>Title:</b> <span t-out="''"/></div>
											<div><b>Name:</b> <span t-field="o.patient_id.name"/></div>
											<div><b>Gender :</b> <span t-field="o.sex"/></div>
											<div><b>Date of Birth :</b> <span t-field="o.date_of_birth"/></div>
											<div><b>Age:</b> <span t-field="o.age"/></div>
											<div><b>Blood Group:</b> <span t-field="o.blood_type"/></div>
											<div>
												<b>Address:</b>
												<span t-out="'%s' % o.patient_id.street if o.patient_id.street else ''"/>
												<span t-out="'%s' % o.patient_id.street2 if o.patient_id.street2 else ''"/>
												<span t-out="'%s' % o.patient_id.country_id.name if o.patient_id.country_id.name else ''"/>
												<span t-out="'%s' % o.patient_id.state_id.name if o.patient_id.state_id.name else ''"/>
											</div>
											<div><b>Phone No:</b> <span t-field="o.patient_id.phone"/></div>
										</div>
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>
			</t>
		</t>
	</template>

	<template id="report_patient_card">
		<t t-call="web.html_container">
			<t t-foreach="docs" t-as="o">
				<t t-set="doc_lang" t-value="(o.patient_id and o.patient_id.lang) or env.lang"/>
				<t t-call="basic_hms.report_patient_card_document"
					t-lang="doc_lang" />
			</t>
		</t>
	</template>
</odoo>
